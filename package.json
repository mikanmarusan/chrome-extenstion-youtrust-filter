{
  "name": "youtrust-filter",
  "version": "2.1.0",
  "description": "YOUTRUST.jpのつながりページで特定企業をフィルターする拡張機能",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.251",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^8.54.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "minimatch@9.0.0 - 9.0.6": "9.0.9",
    "serialize-javascript": "7.0.5",
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 42,
        "functions": 52,
        "lines": 48,
        "statements": 48
      }
    }
  }
}
