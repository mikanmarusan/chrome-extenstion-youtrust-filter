{
  "name": "youtrust-filter",
  "version": "2.1.0",
  "description": "YOUTRUST.jpのつながりページで特定企業をフィルターする拡張機能",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 42,
        "functions": 52,
        "lines": 48,
        "statements": 48
      }
    }
  }
}
